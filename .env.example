# Local Ollama server (default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434
# Vision model to use; install it first with `ollama pull <model>`
OLLAMA_MODEL=qwen2.5vl:7b
# Pipeline: "two-stage" (identify, then describe) or "single" (one call)
PIPELINE_MODE=two-stage
# Model for the describe stage; defaults to OLLAMA_MODEL. Can be a text-only model.
# OLLAMA_DESCRIBE_MODEL=qwen2.5vl:7b
